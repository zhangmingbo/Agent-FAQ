# ============================================================
# FAQ 智能问答机器人 - 环境变量配置
# 
# 使用方法:
#   cp .env.example .env
#   然后修改下面的配置项为你的实际值
# ============================================================

# ========== 服务配置 ==========
PORT=3001
NODE_ENV=production

# ========== 数据库配置 ==========
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=faqbot
DB_PASSWORD=your_database_password_here
DB_NAME=faqdb
DB_CONNECTION_LIMIT=10

# ========== JWT 认证（必需）==========
# 用于登录 token 签名，请修改为随机字符串
JWT_SECRET=change-this-to-a-random-secret-string
JWT_EXPIRES_IN=24h

# 管理员账号（首次登录使用）
ADMIN_USER=admin
ADMIN_PASS=your_admin_password_here

# ========== FAQ 引擎配置（可选，有默认值）==========
# MIN_CONFIDENCE=0.5
# CLARIFY_THRESHOLD=0.65
# TOP_K=5
# MEANINGLESS_MODE=rule

# ========== LLM 大模型配置（可选）==========
# LLM_ENABLED=false
# LLM_API_URL=
# LLM_API_KEY=
# LLM_MODEL=
