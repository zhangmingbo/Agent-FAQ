# FAQ Bot Environment Configuration
# Copy this file to .env and fill in your actual values

# ========== Server Configuration ==========
PORT=3001
NODE_ENV=production

# ========== Database Configuration ==========
DB_HOST=localhost
DB_PORT=3306
DB_USER=aibot
DB_PASSWORD=your_database_password_here
DB_NAME=faqdb
DB_CONNECTION_LIMIT=10

# ========== JWT Authentication ==========
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRES_IN=24h
ADMIN_USER=admin
ADMIN_PASS=your_admin_password_here

# ========== Optional: Engine Configuration ==========
# MIN_CONFIDENCE=0.5
# CLARIFY_THRESHOLD=0.65
# TOP_K=5
# MEANINGLESS_MODE=rule
# ========== 服务配置 ==========
PORT=3001
NODE_ENV=development

# ========== 数据库配置 ==========
DB_HOST=rm-bp11ucz7dz696m6w5zo.mysql.rds.aliyuncs.com
DB_PORT=3306
DB_USER=aibot
DB_PASSWORD=myegoo@3466
DB_NAME=faqdb
DB_CONNECTION_LIMIT=10

# ========== FAQ 引擎配置 ==========
MIN_CONFIDENCE=0.5
CLARIFY_THRESHOLD=0.65
TOP_K=5
MEANINGLESS_MODE=rule

# ========== LLM 配置（可选）==========
# LLM_ENABLED=false
# LLM_API_URL=
# LLM_API_KEY=
# LLM_MODEL=

# ========== JWT 认证 ==========
JWT_SECRET=faq-bot-secret-change-in-production
JWT_EXPIRES_IN=24h
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
